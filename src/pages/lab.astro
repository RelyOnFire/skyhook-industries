---
import Lab from '../lab/Lab';
import LabLayout from '../layouts/LabLayout.astro';
---
<LabLayout title="Tether Lab — Orbital Workbench" description="Design a space tether, fly a payload transfer, and recover the orbit. An interactive orbital workbench by Skyhook Industries.">
  <Lab client:only="react">
    <main slot="fallback" class="guide" id="lab-content">
      <h1>Loading the orbital workbench…</h1>
      <p>Design. Fly. Recover. Your calculation runs in this browser.</p>
      <noscript><p>The simulator needs JavaScript. The <a href="/lab/method/">model guide</a> and <a href="/lab/architectures/">architecture catalogue</a> do not.</p></noscript>
    </main>
  </Lab>
</LabLayout>
