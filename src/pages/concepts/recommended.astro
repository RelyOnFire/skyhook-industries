  <style>
    :root{--bg:#030506;--paper:#e8e4da;--text:#f5f7f7;--muted:#9eaaaf;--line:#29383f;--ice:#d9e9ed;--orange:#cb5b31;--ink:#171a1c;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:var(--bg);color:var(--text)}*{box-sizing:border-box}html{background:var(--bg)}body{margin:0;background:#030506}a{color:inherit}.nav{position:absolute;z-index:20;left:0;top:0;width:100%;display:flex;justify-content:space-between;align-items:center;padding:1.3rem 1.6rem;font:700 .68rem/1 ui-monospace,monospace;letter-spacing:.12em;text-transform:uppercase}.nav a{text-decoration:none}.hero{height:100svh;min-height:720px;position:relative;overflow:hidden}.space{position:absolute;inset:0;background:radial-gradient(circle at 78% 12%,rgba(59,104,130,.18),transparent 30%),linear-gradient(#020405,#05090c)}.earth{position:absolute;width:min(92vw,1350px);aspect-ratio:1;right:-29vw;bottom:-57vw;border-radius:50%;background:radial-gradient(circle at 27% 24%,#46748c 0,#1b4259 18%,#0c1b24 49%,#030608 69%);box-shadow:0 -25px 120px rgba(92,171,213,.16)}.earth:after{content:"";position:absolute;inset:-2px;border-radius:50%;border-top:2px solid rgba(201,234,245,.55);transform:rotate(-17deg)}.tether{position:absolute;width:3px;height:180vh;left:64%;top:-38vh;background:linear-gradient(to bottom,rgba(255,255,255,.03),#91a1a8 14%,#f7fbfc 48%,#75878e 84%,rgba(255,255,255,.04));transform:rotate(23deg);transform-origin:center}.tether .node{position:absolute;left:50%;transform:translateX(-50%);width:10px;height:10px;border-radius:50%;background:#f5f8f9;box-shadow:0 0 15px rgba(255,255,255,.2)}.tether .n1{top:11%}.tether .n2{top:50%;width:14px;height:14px}.tether .n3{bottom:10%}.annotation{position:absolute;z-index:5;font:700 .63rem/1.4 ui-monospace,monospace;color:#b5c2c7;letter-spacing:.08em}.a1{right:3%;top:24%}.a2{right:8%;top:39%}.a3{left:52%;bottom:15%}.annotation:before{content:"";display:block;width:6rem;border-top:1px solid #6f8189;margin-bottom:.55rem}.hero-copy{position:absolute;z-index:6;left:max(1.5rem,calc((100vw - 1180px)/2));bottom:7vh;width:min(760px,calc(100% - 3rem))}.eyebrow{font:700 .68rem/1 ui-monospace,monospace;letter-spacing:.15em;text-transform:uppercase;color:#cadce2}.hero h1{font-size:clamp(4rem,9vw,9.5rem);line-height:.82;letter-spacing:-.078em;margin:.7rem 0 1.6rem;max-width:8.5ch}.hero-copy>p:last-child{font-size:clamp(1.12rem,1.8vw,1.42rem);line-height:1.52;max-width:48rem;color:#c3cdd1}.chapter{width:min(1160px,calc(100% - 3rem));margin:auto;padding:8rem 0;border-top:1px solid rgba(255,255,255,.1)}.chapter-head{display:grid;grid-template-columns:14rem 1fr;gap:3rem}.chapter-label{font:700 .66rem/1.5 ui-monospace,monospace;letter-spacing:.13em;text-transform:uppercase;color:#b9ccd3}.chapter h2{font-size:clamp(3rem,6vw,6.8rem);line-height:.88;letter-spacing:-.065em;margin:0 0 1.5rem;max-width:11ch}.chapter .lede{font-family:Georgia,serif;font-size:1.25rem;line-height:1.65;color:#c3cbce;max-width:50rem}.mechanism{display:grid;grid-template-columns:1fr 1fr;gap:5rem;margin-top:4rem;align-items:center}.figure{border-top:1px solid #53656d;padding-top:.8rem}.fig-head{display:flex;justify-content:space-between;font:700 .62rem/1 ui-monospace,monospace;letter-spacing:.1em;color:#9fb0b7;margin-bottom:.8rem}.figure svg{width:100%;display:block}.mechanism-copy p{font-family:Georgia,serif;font-size:1.08rem;line-height:1.72;color:#b9c3c7}.sequence{margin-top:5rem;border-top:1px solid #3a494f}.row{display:grid;grid-template-columns:5rem 12rem 1fr;gap:1.5rem;padding:1.3rem 0;border-bottom:1px solid #2e3b40}.row b,.row strong{font:700 .68rem/1.4 ui-monospace,monospace}.row span{font-family:Georgia,serif;color:#aeb9bd}.paper{background:var(--paper);color:var(--ink)}.paper .chapter{border-color:#96958f}.paper .chapter-label{color:#335e73}.paper .lede{color:#373d40}.study-grid{display:grid;grid-template-columns:repeat(4,1fr);border-left:1px solid #84857f;margin-top:3.5rem}.study{border-right:1px solid #84857f;border-top:1px solid #84857f;border-bottom:1px solid #84857f;padding:1.3rem;min-height:9rem}.study span{display:block;font:700 .61rem/1 ui-monospace,monospace;letter-spacing:.12em;color:#666a6c;margin-bottom:1rem}.study strong{font-size:1rem}.paper .figure{border-color:#777a77}.hard{background:#111415;color:#f2f0ea;border-left:12px solid var(--orange);margin-top:4rem;padding:1.5rem}.hard-row{display:grid;grid-template-columns:10rem 1fr;gap:1rem;padding:1rem 0;border-bottom:1px solid #4a5052}.hard-row:last-child{border-bottom:0}.hard-row b{font:700 .67rem/1.4 ui-monospace,monospace;color:#ee8354}.hard-row span{font:600 .77rem/1.5 ui-monospace,monospace;color:#c0c6c8}.research{display:grid;grid-template-columns:1fr 1fr;gap:4rem;margin-top:3rem}.research article{border-top:1px solid #89908d;padding-top:1rem}.research small{font:700 .63rem/1 ui-monospace,monospace;letter-spacing:.1em;color:#5b6568}.research h3{font-size:1.5rem;margin:.8rem 0}.research p{font-family:Georgia,serif;line-height:1.65;color:#42484a}.closing{height:72vh;min-height:620px;position:relative;display:flex;align-items:center;justify-content:center;text-align:center;overflow:hidden}.closing:before{content:"";position:absolute;width:75vw;aspect-ratio:1;border-radius:50%;bottom:-62vw;background:radial-gradient(circle at 50% 0,#17435d,#09131a 47%,#010203 69%);box-shadow:0 -25px 80px rgba(103,185,224,.12)}.closing div{position:relative;z-index:2}.closing h2{font-size:clamp(3rem,7vw,7.8rem);line-height:.88;letter-spacing:-.07em;max-width:12ch;margin:auto}.closing p{max-width:43rem;color:var(--muted);margin:1.5rem auto;line-height:1.6}.back{position:fixed;right:1rem;bottom:1rem;z-index:20;border:1px solid #405159;background:rgba(3,5,6,.82);padding:.75rem 1rem;text-decoration:none;font:700 .65rem/1 ui-monospace,monospace;letter-spacing:.1em;text-transform:uppercase}@media(max-width:850px){.chapter-head,.mechanism{grid-template-columns:1fr}.study-grid{grid-template-columns:1fr 1fr}.research{grid-template-columns:1fr}.earth{width:120vw;right:-55vw;bottom:-59vw}.tether{left:73%}.annotation{display:none}.row{grid-template-columns:4rem 1fr}.row span{grid-column:2}}@media(max-width:540px){.chapter{width:calc(100% - 2rem)}.study-grid{grid-template-columns:1fr}.nav span:nth-child(2){display:none}}
  </style>
