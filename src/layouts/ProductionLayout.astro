---
import '../styles/production.css';
import '../styles/polish.css';
import '../styles/architecture.css';
import '../styles/orbital.css';
import '../styles/company.css';
import '../styles/heritage.css';
import SiteHeader from '../components/SiteHeader.astro';
import BrandMark from '../components/BrandMark.astro';
import PageMeta from '../components/PageMeta.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <PageMeta title={title} description={description} noindex={noindex} />
  </head>
  <body class:list={{ 'company-page': path !== '/' }}>
    <a class="skip" href="#content">Skip to content</a>
    <SiteHeader />
    <main id="content"><slot /></main>
    <footer class="site-footer">
      <div class="footer-top">
        <div>
          <a class="wordmark" href="/"><BrandMark /><span>Skyhook Industries</span></a>
          <p>Rotating orbital transportation and momentum-exchange infrastructure.</p>
        </div>
        <div class="footer-nav">
          <a href="/lab/">Tether Lab</a><a href="/lab/campaign/">Expeditions</a><a href="/system/">System</a><a href="/missions/finlay/">Finlay mission</a><a href="/reference-architecture/">Reference Architecture</a><a href="/research/">Research</a><a href="/roadmap/">Roadmap</a><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/help/">Help &amp; saves</a><a href="/contact/#feedback">Feedback</a><a href="/archive/">Archive</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} Skyhook Industries</span>
        <a href="https://github.com/RelyOnFire/skyhook-industries">Source on GitHub ↗</a>
      </div>
    </footer>
  </body>
</html>
