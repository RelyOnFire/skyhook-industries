---
import BrandMark from '../components/BrandMark.astro';
import Favicons from '../components/Favicons.astro';
import '../styles/production.css';
import '../styles/polish.css';
import '../styles/architecture.css';
import '../styles/orbital.css';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  description: string;
  theme?: 'dark' | 'paper';
  noindex?: boolean;
}

const { title, description, theme = 'dark', noindex = false } = Astro.props;
const path = Astro.url.pathname;
const paperPaths = ['/research/', '/reference-architecture/', '/about/', '/contact/', '/archive/'];
const effectiveTheme = theme === 'paper' || paperPaths.includes(path) ? 'paper' : 'dark';
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL('/social-card.svg', Astro.site);
const socialImageAlt = 'Skyhook Industries — rotating orbital transportation';
---
<!doctype html>
<html lang="en" data-theme={effectiveTheme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={effectiveTheme === 'paper' ? '#e8e4da' : '#030506'} />
    <link rel="canonical" href={canonical} />
    <Favicons />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Skyhook Industries" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <SiteHeader />
    <main id="content"><slot /></main>
    <footer class="site-footer">
      <div class="footer-top">
        <div>
          <a class="wordmark" href="/"><BrandMark /><span>Skyhook Industries</span></a>
          <p>Rotating orbital transportation and momentum-exchange infrastructure.</p>
        </div>
        <div class="footer-nav">
          <a href="/lab/">Tether Lab</a><a href="/lab/operations/">Operations</a>
          <a href="/system/">System</a><a href="/reference-architecture/">Reference Architecture</a><a href="/research/">Research</a><a href="/roadmap/">Roadmap</a><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/archive/">Archive</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} Skyhook Industries</span>
        <a href="https://github.com/RelyOnFire/skyhook-industries">Source on GitHub ↗</a>
      </div>
    </footer>
  </body>
</html>
