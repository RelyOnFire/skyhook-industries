---
import '../lab/lab.css';
import '../lab/styles/orbital-theme.css';
import SiteHeader from '../components/SiteHeader.astro';
import PageMeta from '../components/PageMeta.astro';
interface Props { title: string; description: string; active?: 'lab' | 'method' | 'architectures' | 'campaign'; }
const { title, description, active = 'lab' } = Astro.props;
const links = [ ['lab', 'Flight studio', '/lab/'], ['campaign', 'Expeditions', '/lab/campaign/'], ['architectures', 'Architectures', '/lab/architectures/'], ['method', 'Method', '/lab/method/'] ];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <PageMeta title={title} description={description} noindex={true} experience={active === 'campaign' ? 'campaign' : 'lab'} />
  </head>
  <body class="lab-body">
    <a class="lab-skip" href="#lab-content">Skip to content</a>
    <SiteHeader />
    <nav class="lab-section-nav" aria-label="Lab navigation">
      <span>Tether Lab</span>
      {links.map(([id, label, href]) => <a href={href} aria-current={active === id ? 'page' : undefined}>{label}</a>)}
    </nav>
    <slot />
    <footer class="lab-imagery-credit"><a href="/lab/method/#imagery">Planetary imagery & credits ↗</a></footer>
  </body>
</html>

<style>.lab-imagery-credit{max-width:1500px;margin:0 auto;padding:18px 24px;font-size:11px;color:#8fa1ab}.lab-imagery-credit a{color:inherit;text-underline-offset:3px}</style>
