---
import Favicons from '../components/Favicons.astro';
import '../lab/lab.css';
import '../lab/styles/orbital-theme.css';
import SiteHeader from '../components/SiteHeader.astro';
interface Props { title: string; description: string; active?: 'lab' | 'method' | 'architectures' | 'operations' | 'designer'; }
const { title, description, active = 'lab' } = Astro.props;
const links = [ ['lab', 'Flight studio', '/lab/'], ['operations', 'Operations', '/lab/operations/'], ['designer', 'Designer', '/lab/designer/'], ['architectures', 'Architectures', '/lab/architectures/'], ['method', 'Method', '/lab/method/'] ];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080b0d" />
    <meta name="robots" content="noindex,follow" />
    <Favicons />
  </head>
  <body class="lab-body">
    <a class="lab-skip" href="#lab-content">Skip to content</a>
    <SiteHeader />
    <nav class="lab-section-nav" aria-label="Lab navigation">
      <span>Tether Lab</span>
      {links.map(([id, label, href]) => <a href={href} class:list={{active:active === id}} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a>)}
    </nav>
    <slot />
  </body>
</html>
